COMPOSE_PROJECT_NAME=creditflow
APP_ENV=develop

FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

POSTGRES_DB=creditflow
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=change-me

DB_CONNECT_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=15
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 本機為 HTTP，session cookie 不加 Secure 旗標
SECURE_COOKIES=false
NUXT_PUBLIC_API_BASE=/api
BACKEND_INTERNAL_URL=http://api:8080

# PII 加密金鑰（base64 編碼的 32 bytes）
# 產生方式：openssl rand -base64 32
# develop 留空會使用內建的不安全測試金鑰；production 留空則拒絕啟動
PII_ENCRYPTION_KEY=

# 限流（每分鐘每 IP）
# develop 刻意放寬：端到端腳本一輪會進行十餘次登入，且所有請求
# 都經由同一個 Nuxt proxy，對後端而言來自同一個 IP。
RATE_LIMIT_PER_MINUTE=2000
AUTH_RATE_LIMIT_PER_MINUTE=500

# 本服務只經由 Nuxt proxy 對外，故信任 X-Forwarded-For 的最後一跳
TRUST_PROXY=true

# 郵件（develop 由 compose 指向 MailHog，網頁介面在 http://localhost:18025）
MAILHOG_SMTP_PORT=11025
MAILHOG_HTTP_PORT=18025
PUBLIC_BASE_URL=http://localhost:13000
MAIL_FROM=no-reply@creditflow.test
