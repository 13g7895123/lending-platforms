COMPOSE_PROJECT_NAME=creditflow
APP_ENV=production

FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

POSTGRES_DB=creditflow
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

DB_CONNECT_TIMEOUT_SECONDS=90
REQUEST_TIMEOUT_SECONDS=15
CORS_ALLOWED_ORIGINS=https://creditflow.example.com
NUXT_PUBLIC_API_BASE=/api
BACKEND_INTERNAL_URL=http://api:8080
