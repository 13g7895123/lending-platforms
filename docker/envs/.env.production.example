COMPOSE_PROJECT_NAME=creditflow
APP_ENV=production

FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

POSTGRES_DB=creditflow
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

DB_CONNECT_TIMEOUT_SECONDS=90
REQUEST_TIMEOUT_SECONDS=15
CORS_ALLOWED_ORIGINS=https://creditflow.example.com
# 正式環境走 HTTPS，session cookie 必須帶 Secure 旗標
SECURE_COOKIES=true
NUXT_PUBLIC_API_BASE=/api
BACKEND_INTERNAL_URL=http://api:8080

# PII 加密金鑰（base64 編碼的 32 bytes）
# 產生方式：openssl rand -base64 32
# develop 留空會使用內建的不安全測試金鑰；production 留空則拒絕啟動
PII_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# 限流（每分鐘每 IP）
#
# 注意：若前方有反向代理或 CDN，所有請求對本服務而言可能來自同一個 IP，
# 此時配額會被所有使用者共用。請確認代理會轉發真實來源位址
# （本專案的 Nuxt proxy 會把對端位址附加在 X-Forwarded-For 鏈尾），
# 並依實際流量調整下列數值。
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=60

# 本服務只經由 Nuxt proxy 對外，故信任 X-Forwarded-For 的最後一跳
TRUST_PROXY=true

# 郵件。SMTP_HOST 留空時不寄信（僅寫入日誌），正式環境必須填入。
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=no-reply@creditflow.example.com
# 信件連結使用的對外網址，必須是使用者瀏覽器可達的位址
PUBLIC_BASE_URL=https://creditflow.example.com
